{
  "name": "mockbird",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:http": "next dev --webpack -p 8600",
    "certs": "node scripts/dev-certs.mjs",
    "certs:force": "node scripts/dev-certs.mjs --force",
    "certs:trust": "sudo cp mkcert/rootCA.pem /usr/local/share/ca-certificates/mockbird-dev-ca.crt && sudo update-ca-certificates",
    "build": "pnpm run copy:ort && pnpm run copy:tokenizer && next build",
    "build:webpack": "pnpm run copy:ort && pnpm run copy:tokenizer && next build --webpack",
    "start": "next start -p 8600",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run build",
    "copy:ort": "node scripts/copy-ort.mjs",
    "copy:tokenizer": "node scripts/copy-tokenizer-worker.mjs",
    "sync:vendor": "node scripts/sync-runtime-vendor.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:fresh": "node scripts/e2e.mjs --fresh",
    "postinstall": "node scripts/copy-ort.mjs && node scripts/copy-tokenizer-worker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jotai": "^3.0.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "onnxruntime-web": "1.24.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.4.2"
}
